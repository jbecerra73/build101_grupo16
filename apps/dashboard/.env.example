# Dashboard + pipeline settings. The pipeline runs inside the Next server
# process (`npm run dashboard`), so these are read by that process.
#
# Where values come from, first wins:
#   1. the shell environment
#   2. apps/dashboard/.env.local   (copy this file there to override)
#   3. <repo>/.env.local           (loaded by lib/orchestrator.ts; secrets go here)
#   4. the demo defaults in lib/orchestrator.ts (shown below)
# Never commit .env.local files (they are gitignored).

# --- Secrets: put these in <repo>/.env.local, not here --------------------
# Analyzer findings: ANTHROPIC_API_KEY -> Messages API; else
# CLAUDE_CODE_OAUTH_TOKEN -> Agent SDK; else deterministic heuristic.
# The server log prints which one was used: "analyzed <run>: N findings via agent-sdk".
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- Swarm -----------------------------------------------------------------
# replay = offline demo: replays a recorded run folder as a live swarm.
# p2     = the real tenki swarm (not wired yet).
SWARM_RUNNER=replay
# Recorded runs replayed for the baseline and for the retest (absolute paths;
# default <repo>/runs/fixture-baseline and <repo>/runs/fixture-retest).
# REPLAY_DIR=/abs/path/to/runs/fixture-baseline
# REPLAY_RETEST_DIR=/abs/path/to/runs/fixture-retest
# Playback speed. The baseline recording is ~46 s, so 1.5 gives ~30 s of
# swarm on screen (retest ~25 s). Use 4-8 for a quick smoke test.
REPLAY_SPEED=1.5

# --- Fix loop --------------------------------------------------------------
# fake = rehearsal (default with replay): same fix.json transitions, a real
#        retest + verdict, but no coding agent and no PR.
# real = P1's runFixLoop (coding agent in a tenki sandbox, draft PR, preview).
# FIX_LOOP=fake
# Delay of each simulated fix stage (coding agent, preview), in ms.
# FIX_STAGE_DELAY_MS=1500
# FIX_SHELL=tenki   # or local (real fix loop only)

# --- Misc --------------------------------------------------------------------
# Check <meta name="build-sha"> on the target before swarming. Default: off
# with replay (the recorded sha is used), on otherwise.
# VERIFY_BUILD=0
# Runs per day across the dashboard and CLI (counted in runs/.usage.json).
# MAX_RUNS_PER_DAY=10
# Where run folders live. Default <repo>/runs.
# RUNS_DIR=/abs/path/to/runs
