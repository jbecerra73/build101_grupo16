# Dashboard + pipeline settings. With ORCHESTRATOR=inline (the local default)
# the orchestrator runs inside the Next server process (`npm run dashboard`),
# so these are read by that process.
#
# Where values come from, first wins:
#   1. the shell environment
#   2. apps/dashboard/.env.local   (copy this file there to override)
#   3. <repo>/.env.local           (loaded by lib/orchestrator.ts; secrets go here)
#   4. the demo defaults in lib/orchestrator.ts (shown below)
# Empty values count as unset. Never commit .env.local files (they are gitignored).

# --- Secrets: put these in <repo>/.env.local, not here --------------------
# Analyzer findings: ANTHROPIC_API_KEY -> Messages API; else
# CLAUDE_CODE_OAUTH_TOKEN -> Agent SDK; else deterministic heuristic. The server
# log prints which path was used ("analyzed <run>: ... findings via agent-sdk").
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- PostHog ---------------------------------------------------------------
# file = data/posthog/events.jsonl from `npm run posthog:generate` (offline demo)
# api  = HogQL against the project (needs the three POSTHOG_* below)
POSTHOG_SOURCE=file
# POSTHOG_DATA_DIR=/abs/path/to/data/posthog
# POSTHOG_HOST=https://us.i.posthog.com       # ingestion
# POSTHOG_APP_HOST=https://us.posthog.com     # app / query API
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# Finding example sessions link to <app host>/project/${POSTHOG_PROJECT_ID}/replay/<id>
# when the project id and a host are set. With the api source, the current production release:
# PRODUCTION_BUILD_SHA=

# --- Re-test swarm ---------------------------------------------------------
# offline = posthog-sim agents on the "fixed" store, played out in ~30 s:
#           screenshots from apps/dashboard/scripts/shots, PostHog events into
#           data/posthog/swarm-<runId>.jsonl after a ~4 s ingestion lag.
# tenki   = P2's real swarm (registerTenkiSwarmRunner in packages/pipeline).
SWARM_RUNNER=offline
# Offline swarm speed (>1 is faster). Use 4-8 for a quick smoke test.
# SWARM_SPEED=1
# SWARM_SHOTS_DIR=/abs/path/to/apps/dashboard/scripts/shots

# --- Fix loop --------------------------------------------------------------
# fake = rehearsal (default with the offline swarm): same fix.json transitions,
#        a real re-test + the analyzer's verdict, no coding agent and no PR.
# real = P1's runFixLoop (orchestrator/fix-loop.ts, or FIX_LOOP_MODULE); fails
#        with "P1 fix loop not available" until it exists.
# FIX_LOOP=fake
# FIX_STAGE_DELAY_MS=1500

# --- Orchestrator, caps, store -----------------------------------------------
# Deployed setup: docs/DEPLOY.md (Netlify sets RUN_STORE=blobs, ORCHESTRATOR=queue
# and DASHBOARD_REQUIRE_PASSWORD=1 in netlify.toml; they are baked in at build time).
# ORCHESTRATOR=inline        # or queue (alias: daemon): Analyze only enqueues and
#                            # `npm run orchestrator` takes the queue in another process
# MAX_RUNS_PER_DAY=10
# DEFAULT_SEEDS_PER_PERSONA=10
# RUNS_DIR=/abs/path/to/runs
# RUN_STORE=fs               # or blobs (Netlify; outside Netlify also NETLIFY_SITE_ID + NETLIFY_AUTH_TOKEN)
# ORCHESTRATOR_WORK_DIR=     # local run folders when RUN_STORE=blobs (default <repo>/.orchestrator-work)
# DASHBOARD_PASSWORD=        # enables the password gate (proxy.ts)
# AUTH_SECRET=               # optional cookie signing key (default: the password)
# DASHBOARD_REQUIRE_PASSWORD=1  # fail closed: without DASHBOARD_PASSWORD serve only a "set it" page
