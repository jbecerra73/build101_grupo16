# Optional: direct Messages API key (preferred for the findings pass)
ANTHROPIC_API_KEY=
# Fallback: Claude Code OAuth token, used via the Claude Agent SDK
CLAUDE_CODE_OAUTH_TOKEN=

# PostHog source: file (default, data/posthog/) or api (HogQL)
POSTHOG_SOURCE=file
# file: folder with events.jsonl and swarm-<runId>.jsonl (default data/posthog)
POSTHOG_DATA_DIR=
# api: API host, project id and a personal API key with query:read
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
