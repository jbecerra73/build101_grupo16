# Optional: direct Messages API key (preferred for the findings pass)
ANTHROPIC_API_KEY=
# Fallback: Claude Code OAuth token, used via the Claude Agent SDK
CLAUDE_CODE_OAUTH_TOKEN=

# PostHog (SPEC.md, "PostHog source"). Project key sends events, personal key queries them.
# Source: file (default, data/posthog/) or api (HogQL)
POSTHOG_SOURCE=file
# file: folder with events.jsonl and swarm-<runId>.jsonl (default data/posthog)
POSTHOG_DATA_DIR=
POSTHOG_PROJECT_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Ingestion host (capture, /batch) and app host (query API) differ
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_APP_HOST=https://us.posthog.com
