# Optional: direct Messages API key (preferred for the findings pass)
ANTHROPIC_API_KEY=
# Fallback: Claude Code OAuth token, used via the Claude Agent SDK
CLAUDE_CODE_OAUTH_TOKEN=

# PostHog (SPEC.md, "PostHog source"). Project key sends events, personal key queries them.
# Source: file (default, data/posthog/) or api (HogQL)
POSTHOG_SOURCE=file
# file: folder with events.jsonl and swarm-<runId>.jsonl (default data/posthog)
POSTHOG_DATA_DIR=
POSTHOG_PROJECT_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Ingestion host (capture, /batch) and app host (query API) differ
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_APP_HOST=https://us.posthog.com

# --- Deploy: orchestrator in a tenki sandbox (docs/DEPLOY.md) -----------------
# Read by `npm run orchestrator:tenki -- up|status|logs|stop` from <repo>/.env.local.
# The tenki3 key (the SDK also accepts TENKI_AUTH_TOKEN). Never sent into the sandbox.
TENKI_API_KEY=
# Netlify site the dashboard runs on (shimmering-melomakarona-fcc08f) and a
# personal access token for its Blobs store. Both go into the sandbox's env file.
NETLIFY_SITE_ID=3f4a82b8-25c2-4073-9ab0-acfbac435e44
NETLIFY_AUTH_TOKEN=
# Optional: boot from a snapshot, sandbox lifetime, which ref to clone, a GitHub token
TENKI_CHROME_SNAPSHOT_ID=
TENKI_MAX_HOURS=8
TENKI_REPO_REF=
GITHUB_TOKEN=
