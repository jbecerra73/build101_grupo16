# Optional: direct Messages API key (preferred for the findings pass)
ANTHROPIC_API_KEY=
# Fallback: Claude Code OAuth token, used via the Claude Agent SDK
CLAUDE_CODE_OAUTH_TOKEN=
# Re-test swarm on tenki (npm run swarm / swarm:snapshot)
TENKI_API_KEY=
# Printed by `npm run swarm:snapshot`
TENKI_SNAPSHOT_ID=
# Swarm runs allowed per UTC day (runs/.swarm-ledger.json)
SWARM_DAILY_CAP=5
