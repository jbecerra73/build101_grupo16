{
  "name": "frictionswarm",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard": "npm run dev -w @frictionswarm/dashboard",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck -w @frictionswarm/dashboard",
    "pipeline": "tsx packages/pipeline/src/cli.ts",
    "orchestrator": "tsx packages/pipeline/src/daemon.ts",
    "posthog:generate": "tsx tools/posthog-sim/generate.ts",
    "posthog:upload": "tsx tools/posthog-sim/upload.ts",
    "agent": "tsx worker/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "shared",
    "packages/*",
    "apps/*"
  ]
}
